{
  "name": "ff14-idle",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "艾欧泽亚放置 / FF14 Idle — 非商业同人放置游戏",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.config.single.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "python tools/smoke_test.py",
    "test:balance": "python tools/balance_test.py",
    "test:single": "python tools/singlefile_test.py"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
